# ============================================================
# payment-service Dockerfile (multi-stage build)
# 构建：docker build -f Dockerfile.payment-service -t campus-payment-service:latest .
# 运行：docker run -p 8085:8085 --name campus-payment-service campus-payment-service:latest
# ============================================================

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY campus-common/pom.xml campus-common/
COPY payment-service/pom.xml payment-service/
RUN mvn dependency:go-offline -pl payment-service -am -B

COPY campus-common/src campus-common/src
COPY payment-service/src payment-service/src
RUN mvn package -pl payment-service -am -DskipTests -B

FROM eclipse-temurin:17-jre-alpine
RUN addgroup --system campus && adduser --system campus --ingroup campus
USER campus:campus
WORKDIR /app
COPY --from=build /app/payment-service/target/*.jar app.jar
EXPOSE 8085
ENTRYPOINT ["java", "-jar", "app.jar"]
