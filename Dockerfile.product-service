# ============================================================
# product-service Dockerfile (multi-stage build)
# 构建：docker build -f Dockerfile.product-service -t campus-product-service:latest .
# 运行：docker run -p 8081:8081 --name campus-product-service campus-product-service:latest
# ============================================================

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY settings.xml /root/.m2/settings.xml
COPY pom.xml .
COPY campus-common/pom.xml campus-common/
COPY product-service/pom.xml product-service/
# 补齐其余模块 pom 仅用于满足根 pom reactor 解析（不参与构建）
COPY campus-gateway/pom.xml campus-gateway/
COPY user-service/pom.xml user-service/
COPY order-service/pom.xml order-service/
COPY payment-service/pom.xml payment-service/
RUN mvn dependency:go-offline -pl product-service -am -B

COPY campus-common/src campus-common/src
COPY product-service/src product-service/src
RUN mvn package -pl product-service -am -DskipTests -B

FROM eclipse-temurin:17-jre-alpine
RUN addgroup --system campus && adduser --system campus --ingroup campus
USER campus:campus
WORKDIR /app
COPY settings.xml /root/.m2/settings.xml
COPY --from=build /app/product-service/target/*.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
